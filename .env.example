# Leave this empty to use the stand-in answer. Never commit a real key.
ANTHROPIC_API_KEY=

# Optional. A small, fast Claude model is used when this is empty.
CLAUDE_MODEL=

# Optional. Where the demo chat listens. Empty means 127.0.0.1 port 8080.
DEMO_HOST=
DEMO_PORT=

# Optional. How many public chat messages may reach the AI in one Berlin day.
# Empty means 200 for the whole demo. 0 means no overall cap.
# The count is kept in memory. It starts again at midnight in Berlin, or when the demo restarts.
CHAT_DAILY_LIMIT=

# Optional. How many of those messages one visitor may send on that same day.
# Empty means 20. 0 means no per-visitor cap. One visitor is the address that connected.
CHAT_VISITOR_DAILY_LIMIT=
